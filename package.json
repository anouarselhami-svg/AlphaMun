{
  "name": "alpha-mun-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:registration": "vite --config registration-site/vite.config.js --configLoader runner --host 127.0.0.1 --port 5174",
    "build:main": "vite build --configLoader runner",
    "build:registration": "vite build --config registration-site/vite.config.js --configLoader runner",
    "build:all": "npm run build:main && npm run build:registration",
    "test": "node --test tests/registration.test.mjs tests/registration-route.test.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "deploy:main": "npx wrangler pages deploy dist --project-name alpha-mun-main",
    "deploy:registration": "npx wrangler pages deploy dist --cwd registration-site --project-name alphamun-inscription"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
